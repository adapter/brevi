{
  "name": "@brevi/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Local sandbox and orchestrator for coding agents. Connects Linear + GitHub, runs @brevi-tagged tickets in Firecracker microVMs, and opens PRs with demos.",
  "bin": {
    "brevi": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@brevi/orchestrator": "*",
    "@brevi/shared": "*",
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^26.1.2",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  }
}
