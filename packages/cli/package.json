{
  "name": "@brevi/cli",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adapter/brevi.git",
    "directory": "packages/cli"
  },
  "homepage": "https://brevi.dev",
  "bugs": "https://github.com/adapter/brevi/issues",
  "description": "Local sandbox and orchestrator for coding agents. Connects Linear + GitHub, runs @brevi-tagged tickets in Firecracker microVMs, and opens PRs with demos.",
  "bin": {
    "brevi": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target=node --format=esm --external open --external @lydell/node-pty && cp -R ../../apps/app/dist dist/app && cp -R ../sandbox/scripts dist/scripts",
    "build:binary": "bun run scripts/build-binary.ts",
    "dev": "tsc --watch",
    "lint": "oxlint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@brevi/orchestrator": "*",
    "@brevi/sandbox": "*",
    "@brevi/shared": "*",
    "@brevi/worker": "*",
    "@clack/prompts": "^1.7.0",
    "@repo/typescript-config": "*",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "commander": "^15.0.0",
    "oxlint": "^1.77.0",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
