{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brevi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Per-commit previews: CI uploads unreleased versions of the production
  // worker (`wrangler versions upload`), each reachable on its own
  // <version>-brevi-api.<account>.workers.dev URL without shifting traffic.
  "preview_urls": true,
  "env": {
    "production": {
      "name": "brevi-api",
      "routes": [{ "pattern": "api.brevi.dev", "custom_domain": true }]
    }
  }
  // Secrets (set via `wrangler secret put <NAME> --env production`):
  //   GITHUB_CLIENT_ID:     brevi's GitHub OAuth app (device flow enabled)
  //   LINEAR_CLIENT_ID:     brevi's Linear OAuth app
  //   LINEAR_CLIENT_SECRET: its client secret (never leaves this worker)
  // The Linear app must register redirect URIs of the form
  //   http://localhost:<port>/api/connect/linear/callback
  // for the ports brevi uses (default 4400).
}
