---
// Starlight Head override: the default head plus PostHog analytics.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default />

<script>
	import posthog from 'posthog-js';

	// The brevi.dev project token (a publishable phc_ key), injected at build
	// time via PUBLIC_POSTHOG_TOKEN (see .github/workflows/ci.yml). Analytics
	// are disabled when it is unset and in dev builds.
	const POSTHOG_TOKEN = import.meta.env.PUBLIC_POSTHOG_TOKEN;

	if (import.meta.env.PROD && POSTHOG_TOKEN) {
		// Proxied through the worker at /ingest (see src/worker.ts) so analytics
		// requests are first-party, including on *.workers.dev preview deploys.
		posthog.init(POSTHOG_TOKEN, {
			api_host: `${window.location.origin}/ingest`,
			ui_host: 'https://us.posthog.com',
			defaults: '2026-06-25',
		});
	}
</script>
