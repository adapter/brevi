---
// Starlight Head override: the default head plus PostHog analytics.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default />

<script>
	import posthog from 'posthog-js';

	// The brevi.dev project token (phc_… - public by design). Analytics are
	// disabled while this is empty and in dev builds.
	const POSTHOG_TOKEN = 'phc_seRFkKUX3embkS4GScjnXx7zzDYDLn8BJT7FSnNeU6nK';

	if (import.meta.env.PROD && POSTHOG_TOKEN) {
		// Proxied through the worker at /ingest (see src/worker.ts) so analytics
		// requests are first-party, including on *.workers.dev preview deploys.
		posthog.init(POSTHOG_TOKEN, {
			api_host: `${window.location.origin}/ingest`,
			ui_host: 'https://us.posthog.com',
			defaults: '2026-06-25',
		});
	}
</script>
