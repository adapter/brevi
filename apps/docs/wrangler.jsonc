{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brevi-docs",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // The docs site is a static Astro build served as Worker assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Per-commit previews: CI uploads unreleased versions of the production
  // worker (`wrangler versions upload`), each reachable on its own
  // <version>-brevi-docs.<account>.workers.dev URL without shifting traffic.
  "preview_urls": true,
  "env": {
    "production": {
      "name": "brevi-docs",
      "routes": [{ "pattern": "brevi.dev", "custom_domain": true }]
    }
  }
}
