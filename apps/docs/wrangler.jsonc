{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brevi-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // The docs site is a static Astro build served as Worker assets; the
  // worker also reverse-proxies PostHog under /ingest/* (see src/worker.ts).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/ingest/*"]
  },
  // Per-commit previews: CI uploads unreleased versions of the production
  // worker (`wrangler versions upload`), each reachable on its own
  // <version>-brevi-docs.<account>.workers.dev URL without shifting traffic.
  "preview_urls": true,
  "env": {
    "production": {
      "name": "brevi-docs",
      "routes": [{ "pattern": "brevi.dev", "custom_domain": true }]
    }
  }
}
