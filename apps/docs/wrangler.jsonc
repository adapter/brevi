{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brevi-docs",
  "compatibility_date": "2026-08-01",
  // The docs site is a static Astro build served as Worker assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {
      "name": "brevi-docs-preview",
      "workers_dev": true
    },
    "production": {
      "name": "brevi-docs",
      "routes": [{ "pattern": "brevi.dev", "custom_domain": true }]
    }
  }
}
