{
  "name": "@brevi/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Mission Control as a desktop app: an Electron shell that owns and supervises the brevi orchestrator.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adapter/brevi.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://brevi.dev",
  "bugs": "https://github.com/adapter/brevi/issues",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && bun build src/main/index.ts --outfile dist/main.js --target=node --format=esm --external electron --external @lydell/node-pty && cp src/renderer/status.html dist/status.html && cp -R ../app/dist dist/app",
    "dev": "tsc --noEmit --watch",
    "start": "bun run build && bun run scripts/start.ts",
    "package": "bun run build && electron-builder --publish never",
    "package:mac": "bun run build && electron-builder --mac --universal --publish never",
    "package:linux": "bun run build && electron-builder --linux --x64 --publish never",
    "lint": "oxlint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@brevi/app": "*",
    "@brevi/orchestrator": "*",
    "@brevi/sandbox": "*",
    "@brevi/shared": "*",
    "@brevi/worker": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.2"
  }
}
